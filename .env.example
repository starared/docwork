# 复制为 .env 后修改。修改后执行 docker compose up -d 生效。

# ---------- 必填 ----------
# 加密主密钥：用于加密保存 API Key。用 `openssl rand -hex 32` 生成；设置后不要再改，否则已保存的 Key 无法解密。
DW_MASTER_KEY=请替换为随机字符串
# 对外访问地址（生成分享链接用），填浏览器里实际访问的地址
DW_PUBLIC_URL=http://服务器IP:8000

# ---------- 数据与端口 ----------
# 宿主机上的数据目录，相对路径以项目目录为准（容器内以 UID 1000 运行，需要 chown 1000:1000）
DW_HOST_DATA=./data
# Web 服务监听的地址和端口。只允许本机访问时把 DW_BIND 改为 127.0.0.1
DW_BIND=0.0.0.0
DW_PORT=8000

# ---------- 资源配置档 ----------
# 配置档只决定并发数量：standard（重负载任务同时 2 个、AI 任务同时 4 个，默认）、large（2 / 6）、small（1 / 3）。
# 也可以单项覆盖：DW_HEAVY_GLOBAL、DW_AI_CONCURRENCY、DW_PROC_MEM_MB（单个 LibreOffice / OCR 进程的封顶值，MB）。
DW_PROFILE=standard
# 下面的 MEM_* 是各容器的内存封顶值（超过会被系统结束），不是常驻占用：整套服务平时只占 1 GB 左右。
# MEM_HEAVY 是渲染、转换、OCR、预览共用的 worker 容器，要容纳“同时运行的重负载任务数 × 单个大文件峰值”。
# 默认封顶值合计 5248m。
MEM_WEB=1024m
MEM_AI=768m
MEM_HEAVY=3072m
MEM_SCHEDULER=384m
# 机器内存更充裕时可以放宽，例如：
# DW_PROFILE=large
# MEM_WEB=1536m
# MEM_AI=1024m
# MEM_HEAVY=4096m
# MEM_SCHEDULER=512m
# 机器较小时可以收紧，例如（small 同时只运行 1 个重负载任务）：
# DW_PROFILE=small
# MEM_WEB=1024m
# MEM_AI=512m
# MEM_HEAVY=2048m
# MEM_SCHEDULER=384m

# ---------- 安全 ----------
# 通过 HTTPS 访问时设为 true；直接用 http:// 访问必须为 false，否则无法登录
DW_COOKIE_SECURE=false
# 由前置的 Nginx 通过 X-Accel-Redirect 发送文件。不使用 Nginx 时保持 false，由程序直接发送文件
DW_ACCEL_REDIRECT=false
# 沙箱：auto（能用 bubblewrap 就用，不可用时降级为进程资源限制，并在日志和后台“系统状态”中明确提示）、
# bwrap（必须使用 bubblewrap，不可用时相关任务直接失败）、rlimit（只用进程资源限制）。
# 重负载容器本身没有网络、根文件系统只读、没有任何特权。
DW_SANDBOX=auto
# 可信反向代理：只有直连后端的地址在这些网段内时，才读取代理传来的真实客户端地址（用于登录限流）。
# 默认只有本机和 Docker 网段。Nginx 部署在另一台机器上时把它的地址加进来；不要填整个局域网网段，
# 否则局域网里的任何人都能伪造来源地址绕过登录限流。
# DW_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ---------- 可选：联网检索 ----------
# SearXNG 地址（需在 settings.yml 的 search.formats 中开启 json）。留空则不提供联网检索，用户仍可给出参考网页。
# SearXNG 运行在同一台宿主机上并映射了端口时，填 http://host.docker.internal:端口；
# 在另一个 Docker 网络中时，在 docker-compose.override.yml 里让 worker-ai 加入该网络，再填 http://容器名:8080。
DW_SEARXNG_URL=
# 每次检索最多读取的网页数量
# DW_WEB_PAGES=6

# ---------- 可选：restic 每周备份（留空则只做本地数据库备份）----------
DW_RESTIC_REPOSITORY=
DW_RESTIC_PASSWORD=
# 使用对象存储时按 restic 文档设置，例如 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# 调试模式：错误信息显示详细内容。生产环境保持 false。
DW_DEBUG=false
